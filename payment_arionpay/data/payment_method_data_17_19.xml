<?xml version="1.0" encoding="utf-8"?>
<!-- Odoo 17 to 19: payment methods are shared records linked to providers (Odoo 20 uses payment_method_data.xml). -->
<odoo noupdate="1">
    <record id="payment_method_arionpay" model="payment.method">
        <field name="name">Crypto (Bitcoin, USDT and more)</field>
        <field name="code">arionpay</field>
        <field name="sequence">10</field>
        <field name="image" type="base64" file="payment_arionpay/static/description/icon.png"/>
        <field name="support_tokenization">False</field>
        <field name="provider_ids" eval="[Command.link(ref('payment_provider_arionpay'))]"/>
    </record>
</odoo>
